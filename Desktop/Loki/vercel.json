{
  "version": 2,
  "name": "constellation-markets",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "framework": "nextjs",
  "functions": {
    "frontend/pages/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/frontend/pages/api/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}