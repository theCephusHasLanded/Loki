# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/prediction_market
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Watson AI Configuration
WATSON_API_KEY=your-watson-api-key
WATSON_URL=https://api.us-south.watson.ml.cloud.ibm.com
WATSON_PROJECT_ID=your-watson-project-id

# External APIs
NASA_API_KEY=your-nasa-api-key
JPL_API_ENDPOINT=https://ssd-api.jpl.nasa.gov

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=3600000
RATE_LIMIT_MAX=100

# Trading Configuration
DEFAULT_MARKET_FEE=0.02
MAKER_FEE=0.005
MAX_POSITION_SIZE=10000
CIRCUIT_BREAKER_THRESHOLD=0.1